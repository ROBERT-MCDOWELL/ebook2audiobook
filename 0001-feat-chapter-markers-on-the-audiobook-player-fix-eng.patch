+		if(typeof(window.render_chapter_marks) !== "function"){
+			// chapter ticks under the audiobook player seek bar: a thin overlay strip with one clickable mark per
+			// chapter (times and titles from the "chapter <n>" cues parseVTT() collected). Hovering shows the chapter
+			// title; clicking jumps the player there. No-op for older vtt files without chapter cues
+			window.render_chapter_marks = function(){
